# Copia a .env y rellena. Nunca commitees .env ni .tokens.json

# Postgres (Neon)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Web private deployment: set a strong password in the deployment's secret store.
APP_PASSWORD=
# Independent session signing key: generate 32 random bytes as 64 hex characters.
AUTH_SECRET=
APP_URL=
# The local Compose demo sets DEMO_MODE/DATABASE_TRANSPORT itself; leave them unset for live use.
# Opcional: copia comprimida de precios, comprobada contra Postgres en cada uso.
# Actions la conserva entre ejecuciones. No contiene tokens ni capturas privadas.
# PRICE_CACHE_DIR=.cache/prices

# LaLiga Fantasy. Cuenta con contraseña: email + password (ROPC).
# Cuenta de Google: déjalos vacíos y ejecuta `python -m lfm.api.auth login-google` una vez
# (guarda .tokens.json; en local no hace falta nada más).
LALIGA_EMAIL=
LALIGA_PASSWORD=
# Refresh token (de .tokens.json tras `login` o `login-google`). Obligatorio en GitHub Actions.
LALIGA_REFRESH_TOKEN=

# Tu liga privada (ver `python -m lfm.api.auth whoami`)
LEAGUE_ID=
COMPETITION_ID=1

# Hora UTC a la que se renueva el mercado de tu liga (la hora de creación de la liga)
MARKET_RESET_HOUR_UTC=

# Telegram (canal de avisos). Sin esto los mensajes se imprimen y no llega nada.
#   1. Habla con @BotFather, manda /newbot y copia el token aquí.
#   2. Escríbele "hola" a tu bot desde tu cuenta.
#   3. python -m lfm.notify.telegram chat-id --token <TOKEN>   -> te dice el chat_id
#   4. python -m lfm.notify.telegram test                      -> comprueba que llega
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
